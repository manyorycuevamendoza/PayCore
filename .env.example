# Copia este archivo a .env y ajusta lo que necesites.
# NO pongas secretos reales aquí: .env está en .gitignore, .env.example no.

# --- PostgreSQL ---
POSTGRES_USER=paycore
POSTGRES_PASSWORD=paycore
POSTGRES_DB=paycore
# Puerto en el host. 5433 para no chocar con un PostgreSQL ya instalado.
POSTGRES_PORT=5434

# --- API ---
API_PORT=8000
PAYCORE_ENVIRONMENT=development
PAYCORE_LOG_LEVEL=INFO

# Obligatorio si PAYCORE_ENVIRONMENT=production. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYCORE_JWT_SECRET=dev-secret-solo-para-desarrollo-no-usar-en-produccion

# Estrategia de concurrencia: pessimistic | serializable  (ver ADR-0005)
PAYCORE_CONCURRENCY_STRATEGY=pessimistic

# --- Limitación de peticiones (ver ADR-0009) ---
# OJO: el contador vive en memoria del proceso. Con varios workers el límite
# efectivo se multiplica por el número de procesos.
PAYCORE_RATE_LIMIT_ENABLED=true
PAYCORE_LOGIN_RATE_BURST=5
PAYCORE_LOGIN_RATE_PER_MINUTE=10
PAYCORE_TRANSFER_RATE_BURST=10
PAYCORE_TRANSFER_RATE_PER_MINUTE=60
PAYCORE_MAX_REQUEST_BYTES=16384
