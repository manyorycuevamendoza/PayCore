{
  "openapi": "3.1.0",
  "info": {
    "title": "PayCore API",
    "description": "\nMotor transaccional de una billetera digital **simulada**.\n\nPrototipo educativo. Los fondos son ficticios y se expresan en soles peruanos\nsimulados (PEN). No se conecta con Yape, con Credicorp, con entidades\nbancarias ni con pasarelas de pago, y no mueve dinero real.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "autenticación"
        ],
        "summary": "Registrar un usuario ficticio",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "409": {
            "description": "El correo ya está registrado"
          },
          "422": {
            "description": "Datos inválidos o alias en uso"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "autenticación"
        ],
        "summary": "Obtener un token de acceso",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/me": {
      "get": {
        "tags": [
          "cuentas"
        ],
        "summary": "Cuenta propia",
        "operationId": "get_my_account_api_v1_accounts_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/accounts/me/balance": {
      "get": {
        "tags": [
          "cuentas"
        ],
        "summary": "Saldo disponible simulado",
        "operationId": "get_my_balance_api_v1_accounts_me_balance_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/accounts/me/transactions": {
      "get": {
        "tags": [
          "cuentas"
        ],
        "summary": "Historial de movimientos",
        "operationId": "list_my_transactions_api_v1_accounts_me_transactions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovementPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers": {
      "post": {
        "tags": [
          "transferencias"
        ],
        "summary": "Transferir saldo simulado entre cuentas",
        "operationId": "create_transfer_api_v1_transfers_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "UUID v4 generado por el cliente. Obligatorio.",
              "title": "Idempotency-Key"
            },
            "description": "UUID v4 generado por el cliente. Obligatorio."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Falta la cabecera Idempotency-Key"
          },
          "401": {
            "description": "No autenticado"
          },
          "404": {
            "description": "La cuenta de destino no existe"
          },
          "409": {
            "description": "Ya hay una petición en curso con esa clave"
          },
          "422": {
            "description": "Fondos insuficientes, datos inválidos, o la clave de idempotencia se reutilizó con un cuerpo distinto"
          }
        }
      }
    },
    "/api/v1/transfers/{transfer_id}": {
      "get": {
        "tags": [
          "transferencias"
        ],
        "summary": "Estado de una operación",
        "operationId": "get_transfer_api_v1_transfers__transfer_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Transfer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "404": {
            "description": "La operación no existe o no participas en ella"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "alias": {
            "type": "string",
            "title": "Alias"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "PEN"
          },
          "balance_cents": {
            "type": "integer",
            "title": "Balance Cents"
          },
          "balance_display": {
            "type": "string",
            "title": "Balance Display"
          },
          "owner_full_name": {
            "type": "string",
            "title": "Owner Full Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "alias",
          "balance_cents",
          "balance_display",
          "owner_full_name"
        ],
        "title": "AccountResponse"
      },
      "BalanceResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "PEN"
          },
          "balance_cents": {
            "type": "integer",
            "title": "Balance Cents"
          },
          "balance_display": {
            "type": "string",
            "title": "Balance Display"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "balance_cents",
          "balance_display",
          "as_of"
        ],
        "title": "BalanceResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "concurrency_strategy": {
            "type": "string",
            "title": "Concurrency Strategy"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "database",
          "concurrency_strategy"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MovementPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MovementResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "title": "MovementPage"
      },
      "MovementResponse": {
        "properties": {
          "transfer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transfer Id"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "amount_cents": {
            "type": "integer",
            "title": "Amount Cents"
          },
          "amount_display": {
            "type": "string",
            "title": "Amount Display"
          },
          "signed_amount_cents": {
            "type": "integer",
            "title": "Signed Amount Cents"
          },
          "balance_after_cents": {
            "type": "integer",
            "title": "Balance After Cents"
          },
          "counterparty_alias": {
            "type": "string",
            "title": "Counterparty Alias"
          },
          "concept": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "transfer_id",
          "direction",
          "amount_cents",
          "amount_display",
          "signed_amount_cents",
          "balance_after_cents",
          "counterparty_alias",
          "concept",
          "created_at"
        ],
        "title": "MovementResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          },
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name"
          },
          "alias": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Alias"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "full_name",
          "alias"
        ],
        "title": "RegisterRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse"
      },
      "TransferRequest": {
        "properties": {
          "destination_alias": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Destination Alias"
          },
          "amount_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          },
          "concept": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 140
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "destination_alias",
          "amount_cents"
        ],
        "title": "TransferRequest"
      },
      "TransferResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "amount_cents": {
            "type": "integer",
            "title": "Amount Cents"
          },
          "amount_display": {
            "type": "string",
            "title": "Amount Display"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "PEN"
          },
          "source_alias": {
            "type": "string",
            "title": "Source Alias"
          },
          "destination_alias": {
            "type": "string",
            "title": "Destination Alias"
          },
          "concept": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "source_balance_after_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Balance After Cents"
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejection Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "amount_cents",
          "amount_display",
          "source_alias",
          "destination_alias",
          "concept",
          "created_at",
          "completed_at"
        ],
        "title": "TransferResponse"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "alias": {
            "type": "string",
            "title": "Alias"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "full_name",
          "alias"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token JWT de acceso",
        "scheme": "bearer"
      }
    }
  }
}
